        "purchase_price_usd": {"type": "number"},
        "total_shares_accepted": {"type": "integer"},
        "total_shares_returned": {"type": "integer"},
        "total_proceeds_usd": {"type": "number"},
        "engine_scheduled_auto_credit_usd": {"type": "number"}
